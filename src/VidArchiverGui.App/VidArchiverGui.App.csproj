<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>VidArchiverGui</AssemblyName>
    <RootNamespace>VidArchiverGui.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Precompile so the window doesn't wait on the JIT at startup. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- App icon (generated by packaging/make-icon.py). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <!-- License texts: embedded for the About page, and shipped next to the executable as the licenses require. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="VidArchiverGui.LICENSE" />
    <EmbeddedResource Include="..\..\NOTICE" LogicalName="VidArchiverGui.NOTICE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="VidArchiverGui.THIRD-PARTY-NOTICES.txt" />
    <None Include="..\..\LICENSE;..\..\NOTICE;..\..\THIRD-PARTY-NOTICES.txt" Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Build info for the About page: build time and git commit (+ whether the tree had uncommitted changes). Git is
    optional; values are simply left out if it isn't available.
  -->
  <Target Name="AddBuildInfo" BeforeTargets="GetAssemblyAttributes" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitCommitExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true"
          Condition="'$(_GitCommitExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatus" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="BuildTimestamp" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
      <AssemblyMetadata Include="GitCommit" Value="$(_GitCommit)" Condition="'$(_GitCommitExit)' == '0'" />
      <AssemblyMetadata Include="GitDirty" Value="true" Condition="'$(_GitCommitExit)' == '0' And '$(_GitStatus)' != ''" />
    </ItemGroup>
  </Target>

  <!-- SkiaSharp/HarfBuzz ship ~100 MB of native symbols; keep them out of published builds. -->
  <Target Name="RemoveSymbolsAfterPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_PublishedSymbols Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedSymbols)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\VidArchiverGui.Core\VidArchiverGui.Core.csproj" />
  </ItemGroup>
</Project>
